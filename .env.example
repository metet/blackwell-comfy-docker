# ComfyUI Docker Environment Configuration
# Copy this file to .env and adjust the values for your system

# User ID and Group ID for file permission management
# These should match your Linux user to avoid permission issues
# On Linux, run: id -u  (for USER_ID)
#           and: id -g  (for GROUP_ID)
# Default: 1000 (typical first user on Ubuntu/Debian systems)
USER_ID=1000
GROUP_ID=1000

# Optional: Uncomment to customize the ComfyUI port
# Default: 8188
# COMFYUI_PORT=8188

# Optional: Uncomment to customize host paths for ComfyUI data
# Default: ~/comfy/
# COMFY_DATA_PATH=~/comfy
